{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CyberBasic",
  "version": "0.1.0",
  "identifier": "dev.cyberbasic.ide",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CyberBasic",
        "width": 1280,
        "height": 800,
        "maximized": true,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0b0c12"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Make 2D and 3D games in a modern BASIC"
  }
}
