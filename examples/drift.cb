' Drift: fly an animated ship and collect the stars.
' Left/Right turns, Up thrusts, Escape quits. The screen wraps around.
Game "Drift"
Graphics 800, 600
ClsColor 8, 8, 20

ship = LoadAnimImage("assets/ship.svg", 48, 48, 0, 4) ' frame 0: no flame, 1-3: flame flicker

Type Star
    Field x, y
End Type

Function SpawnStar()
    s = New Star
    s.x = Rnd(40, 760)
    s.y = Rnd(40, 560)
End Function

For i = 1 To 5 : SpawnStar : Next

x = 400 : y = 300 : angle = 0 : vx = 0 : vy = 0 : score = 0
While Not KeyHit(KEY_ESCAPE)
    If KeyDown(KEY_LEFT) Then angle -= 220 * Delta
    If KeyDown(KEY_RIGHT) Then angle += 220 * Delta
    thrusting = KeyDown(KEY_UP)
    If thrusting
        vx += Sin(angle) * 320 * Delta
        vy -= Cos(angle) * 320 * Delta
    EndIf
    vx -= vx * 0.6 * Delta : vy -= vy * 0.6 * Delta ' drag
    x = (x + vx * Delta + 800) Mod 800
    y = (y + vy * Delta + 600) Mod 600

    For s = Each Star
        If (s.x - x) ^ 2 + (s.y - y) ^ 2 < 28 ^ 2
            score += 1
            Delete s
            SpawnStar
        EndIf
    Next

    Cls
    Color 255, 220, 90
    For s = Each Star
        Oval s.x - 7, s.y - 7, 14, 14
    Next
    If thrusting Then frame = 1 + Int(Millisecs() / 60) Mod 3 Else frame = 0
    DrawImageEx ship, x, y, angle, 1, frame
    Color 255, 255, 255
    Text 10, 10, "Stars: " + score
    Sync
Wend
